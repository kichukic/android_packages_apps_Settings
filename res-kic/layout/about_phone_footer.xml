<LinearLayout
    android:orientation="vertical"
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_sepatch_background_ripple"
        android:layout_marginHorizontal="@dimen/orion_cardview_padding"
        android:layout_marginTop="@dimen/orion_cardview_padding"
        android:layout_marginBottom="@dimen/orion_cardview_padding">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/orion_card_side_margin"
            android:layout_marginRight="@dimen/orion_card_side_margin">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/orion_card_side_margin"
                android:layout_marginEnd="@dimen/orion_card_side_margin"
                android:layout_marginTop="16dp"
                android:paddingBottom="18dp">

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_kic_spec_selinux"
                        android:tint="@color/material_dynamic_tertiary40"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/selinux_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/orion_selinux_title"
                        style="@style/orion_about_cardview_sepatch_text_primary"/>

                    <TextView
                        android:id="@+id/selinux_summary"
                        style="@style/orion_about_cardview_sepatch_text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/orion_minus_summary"
                        android:text="Enforcing" />
                </LinearLayout>

                <LinearLayout
                    android:gravity="center_vertical"
                    android:orientation="vertical"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_kic_spec_security"
                        android:tint="@color/material_dynamic_tertiary40"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/secpatch_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/orion_secpatch_title"
                        style="@style/orion_about_cardview_sepatch_text_primary"/>

                    <TextView
                        android:id="@+id/secpatch_summary"
                        style="@style/orion_about_cardview_sepatch_text_secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/orion_minus_summary"
                        android:text="November 2026" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
