<LinearLayout
    android:layout_width="fill_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/card_single_background_ripple"
    android:layout_marginHorizontal="@dimen/orion_cardview_padding"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:gravity="center_vertical"
        android:layout_width="fill_parent"
        android:layout_marginVertical="@dimen/orion_pref_vert"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/orion_margin_start"
            android:src="@drawable/ic_kic_maintainer"
            android:tint="@color/orion_icon_dynamic" />

        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <TextView
                android:id="@android:id/title"
                android:ellipsize="marquee"
                android:fadingEdge="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:singleLine="true"
                android:maxLines="1"
                style="@style/orion_about_cardview_text_primary" />

            <TextView
                android:id="@android:id/summary"
                android:ellipsize="marquee"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginStart="14dp"
                android:layout_marginTop="@dimen/orion_minus_summary"
                android:maxLines="1"
                style="@style/orion_about_cardview_text_secondary"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
