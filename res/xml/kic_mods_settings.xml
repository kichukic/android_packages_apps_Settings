<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="kic_mods_dashboard"
    android:title="@string/kic_mods_title">

    <PreferenceCategory
        android:key="kic_mods_tiles_category"
        android:title="@string/kic_feature_hub_title">

        <!-- Tile 1: Play Integrity & Keybox -->
        <Preference
            android:key="kic_tile_integrity"
            android:title="@string/kic_tile_integrity_title"
            android:summary="@string/kic_tile_integrity_summary"
            android:icon="@drawable/ic_settings_security"
            android:layout="@layout/card_preference_layout"
            android:fragment="com.android.settings.kic.PlayIntegritySettings" />

        <!-- Tile 2: Gaming & Performance Spoofing -->
        <Preference
            android:key="kic_tile_gaming"
            android:title="@string/kic_tile_per_app_spoof_title"
            android:summary="@string/kic_tile_per_app_spoof_summary"
            android:icon="@drawable/ic_videogame_vd_theme_24"
            android:layout="@layout/card_preference_layout"
            android:fragment="com.android.settings.kic.PerAppSpoofSettings" />

        <!-- Tile 3: Display & Media Engine -->
        <Preference
            android:key="kic_tile_visuals"
            android:title="@string/kic_tile_visuals_title"
            android:summary="@string/kic_tile_visuals_summary"
            android:icon="@drawable/ic_settings_display_filled"
            android:layout="@layout/card_preference_layout"
            android:fragment="com.android.settings.kic.VisualsMediaSettings" />

        <!-- Tile 4: Status Bar & Interface -->
        <lineageos.preference.LineagePartsPreference
            android:key="status_bar_settings"
            android:title="@string/kic_tile_statusbar_title"
            android:summary="@string/kic_tile_statusbar_summary"
            android:icon="@drawable/ic_settings_system_dashboard_white"
            android:layout="@layout/card_preference_layout" />

        <!-- Tile 5: Hardware & Navigation -->
        <Preference
            android:key="kic_tile_hardware"
            android:title="@string/kic_tile_hardware_title"
            android:summary="@string/kic_tile_hardware_summary"
            android:icon="@drawable/ic_settings_gestures"
            android:layout="@layout/card_preference_layout"
            android:fragment="com.android.settings.kic.HardwareGesturesSettings" />

    </PreferenceCategory>

</PreferenceScreen>
