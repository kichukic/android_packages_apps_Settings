<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="kic_mods_screen"
    android:title="@string/kic_mods_title">

    <PreferenceCategory
        android:key="kic_mods_integrity_category"
        android:title="@string/kic_mods_integrity_category">

        <SwitchPreferenceCompat
            android:key="kic_pif_enabled"
            android:title="@string/kic_pif_enabled_title"
            android:summary="@string/kic_pif_enabled_summary"
            android:defaultValue="true" />

        <Preference
            android:key="kic_pif_import"
            android:title="@string/kic_pif_import_title"
            android:summary="@string/kic_pif_import_summary" />

        <Preference
            android:key="kic_pif_reset"
            android:title="@string/kic_pif_reset_title"
            android:summary="@string/kic_pif_reset_summary" />

        <SwitchPreferenceCompat
            android:key="kic_keybox_enabled"
            android:title="@string/kic_keybox_enabled_title"
            android:summary="@string/kic_keybox_enabled_summary"
            android:defaultValue="true" />

        <Preference
            android:key="kic_keybox_import"
            android:title="@string/kic_keybox_import_title"
            android:summary="@string/kic_keybox_import_summary" />

        <Preference
            android:key="kic_keybox_reset"
            android:title="@string/kic_keybox_reset_title"
            android:summary="@string/kic_keybox_reset_summary" />

        <Preference
            android:key="kic_trickystore_targets"
            android:title="@string/kic_trickystore_targets_title"
            android:summary="@string/kic_trickystore_targets_summary"
            android:fragment="com.android.settings.kic.TrickyStoreTargetSettings" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="kic_mods_media_category"
        android:title="@string/kic_mods_media_category">

        <SwitchPreferenceCompat
            android:key="kic_gphotos_spoof"
            android:title="@string/kic_gphotos_spoof_title"
            android:summary="@string/kic_gphotos_spoof_summary"
            settings:controller="com.android.settings.kic.GPhotosSpoofPreferenceController" />

        <Preference
            android:key="kic_per_app_spoof"
            android:title="@string/kic_per_app_spoof_title"
            android:summary="@string/kic_per_app_spoof_summary"
            android:fragment="com.android.settings.kic.PerAppSpoofSettings" />

        <Preference
            android:key="kic_reality_display"
            android:title="@string/kic_reality_display_title"
            android:summary="@string/kic_reality_display_summary"
            android:fragment="com.android.settings.display.ColorModePreferenceFragment" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="kic_mods_statusbar_category"
        android:title="@string/kic_mods_statusbar_category">

        <lineageos.preference.LineagePartsPreference
            android:key="status_bar_settings"
            android:title="@string/kic_status_bar_title"
            android:summary="@string/kic_status_bar_summary" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="kic_mods_system_category"
        android:title="@string/kic_mods_system_category">

        <lineageos.preference.LineagePartsPreference
            android:key="button_settings"
            android:title="@string/kic_buttons_title" />

        <lineageos.preference.LineagePartsPreference
            android:key="touchscreen_gesture_settings"
            android:title="@string/kic_gestures_title" />

        <lineageos.preference.LineagePartsPreference
            android:key="charging_control"
            android:title="@string/kic_charging_title" />

    </PreferenceCategory>

</PreferenceScreen>
