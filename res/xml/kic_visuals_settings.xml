<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:settings="http://schemas.android.com/apk/res-auto"
    android:key="kic_visuals_screen"
    android:title="@string/kic_tile_visuals_title">

    <PreferenceCategory
        android:key="kic_visuals_media_category"
        android:title="Visual &amp; Media Engine">

        <SwitchPreferenceCompat
            android:key="kic_gphotos_spoof"
            android:title="@string/kic_gphotos_spoof_title"
            android:summary="@string/kic_gphotos_spoof_summary"
            settings:controller="com.android.settings.kic.GPhotosSpoofPreferenceController" />

        <Preference
            android:key="kic_reality_display"
            android:title="@string/kic_reality_display_title"
            android:summary="@string/kic_reality_display_summary"
            android:fragment="com.android.settings.display.ColorModePreferenceFragment" />

    </PreferenceCategory>

</PreferenceScreen>
